# --- AI provider (every provider speaks the OpenAI chat API) ---
# gemini (default): Gemini 4 Argon designs the app and writes the business logic (paid tier only),
#   Gemini 3.8 Flash does the quick jobs. Get a key at https://aistudio.google.com/apikey and enable billing.
# groq: fast, generous free tier
# openrouter: any model, pay as you go
# openai_compatible: any other OpenAI-compatible API (set LLM_BASE_URL + LLM_API_KEY)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
# FREE_TIER=1            # no billing yet: Gemini 3.8 Flash for everything (weaker on complex apps)
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# LLM_BASE_URL=
# LLM_API_KEY=

# Optional overrides; leave unset to use the provider's defaults (backend/agent/config.py).
# `python scripts/check_llm.py --list` shows the model ids your key can use.
# STRONG_MODEL=gemini-4-argon       # design, business logic, hard repairs
# CHEAP_MODEL=gemini-3.8-flash      # the app's look, first repairs
# FALLBACK_MODEL=gemini-3.8-flash   # when a call fails
# How hard each tier thinks: low, medium or high (empty = the model's default).
# STRONG_REASONING=high
# CHEAP_REASONING=low

# Free tiers allow few tokens per minute: fewer calls at once, and 429s are retried with backoff.
LLM_MAX_PARALLEL=4
LLM_MAX_RETRIES=6
# FAKE_LLM=1  # deterministic stand-in model: UI development / offline demo, no tokens spent

# --- Storage ---
# Accounts, projects, versions and agent checkpoints. Empty = SQLite in DATA_DIR.
# On Railway, add a Postgres service and set: PLATFORM_DATABASE_URL=${{Postgres.DATABASE_URL}}
PLATFORM_DATABASE_URL=
DATA_DIR=/data

# --- Harness ---
CODEGEN_MODE=llm          # llm | template
# Healing stops by itself when it stops making progress; this is only a seatbelt.
MAX_HEAL_SAFETY=12
MAX_TOKENS_PER_RUN=150000
MAX_CONCURRENT_RUNS=2
GATE_TIMEOUT_S=60

# --- Object storage for generated zips (optional; any S3-compatible bucket: R2, S3, MinIO ...) ---
# Without it zips stay in DATA_DIR. See docs/DEPLOY.md.
# S3_BUCKET=
# S3_ENDPOINT_URL=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=auto

# --- Sign in with GitHub / Push to GitHub (a GitHub OAuth App; callback <PUBLIC_URL>/api/auth/github/callback) ---
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# PUBLIC_URL=https://vibestack.example.com

# --- Monitoring ---
# METRICS_TOKEN=          # bearer token for /api/metrics (admins can always read it)
# SENTRY_DSN=             # send errors to Sentry (pip install sentry-sdk)
# LOG_FORMAT=json         # json (default) or text

# --- Tools for the Reflector ---
# MCP_PRESETS=docs,github # well-known MCP servers by name (docs/MCP.md)
# GITHUB_MCP_TOKEN=       # read-only GitHub token for the github preset
# External MCP servers whose tools the Reflector may call while it repairs code (JSON list).
# MCP_SERVERS=[{"name": "docs", "url": "https://example.com/mcp", "headers": {"Authorization": "Bearer ..."}}]
# Plugins enabled by default (files in backend/plugins/), e.g. postman,kubernetes,pypi_lookup
PLUGINS=

# --- Accounts and guard rails ---
ACCESS_CODE=              # invite code needed to create an account (leave empty for open sign-up)
ADMIN_EMAILS=             # comma-separated; admins see platform-wide /api/stats and have no daily limit
MAX_RUNS_PER_DAY=25       # per user
SECRET_KEY=               # signs login tokens; generated into DATA_DIR when empty
SANDBOX_MEMORY_MB=2048    # memory limit for generated code
# CORS_ORIGINS=http://localhost:3000
