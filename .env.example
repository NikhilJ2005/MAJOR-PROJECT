# --- LLM (OpenRouter) ---
OPENROUTER_API_KEY=
STRONG_MODEL=anthropic/claude-sonnet-4.5
CHEAP_MODEL=openai/gpt-4o-mini
FALLBACK_MODEL=deepseek/deepseek-chat
# FAKE_LLM=1  # deterministic stand-in model: UI development / offline demo, no tokens spent

# --- Harness ---
CODEGEN_MODE=llm          # llm | template
MAX_HEAL_ITERATIONS=3
MAX_TOKENS_PER_RUN=60000
MAX_CONCURRENT_RUNS=2
GATE_TIMEOUT_S=60

# --- Public deployment guard rails ---
ACCESS_CODE=              # required on POST /api/runs when set
# CORS_ORIGINS=http://localhost:3000
