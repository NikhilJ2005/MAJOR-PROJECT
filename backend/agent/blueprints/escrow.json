   {
    "name": "Milestone",
    "write_roles": [
     "client"
    ],
    "fields": [
     {
      "name": "job_id",
      "references": "Job",
      "on_delete": "cascade"
     },
     {
      "name": "title"
     },
     {
      "name": "amount",
      "type": "decimal",
      "min": 0
     },
     {
      "name": "due_on",
      "type": "date"
     },
     {
      "name": "state",
      "choices": [
       "draft",
       "funded",
       "submitted",
       "approved",
       "disputed",
       "released"
      ],
      "transitions": {
       "draft": [
        "funded"
       ],
       "funded": [
        "submitted",
        "disputed"
       ],
       "submitted": [
        "approved",
        "disputed"
       ],
       "approved": [
        "released"
       ],
       "disputed": [
        "approved",
        "funded"
       ]
      }
     }
    ],
    "sample_rows": [
     {
      "job_id": 1,
      "title": "Theme and homepage",
      "amount": 1000,
      "due_on": "2026-11-05",
      "state": "submitted"
     },
     {
      "job_id": 1,
      "title": "Checkout and launch",
      "amount": 1200,
      "due_on": "2026-11-20",
      "state": "funded"
     },
     {
      "job_id": 3,
      "title": "Logo and palette",
      "amount": 500,
      "due_on": "2026-10-10",
      "state": "released"
     },
     {
      "job_id": 3,
      "title": "Menu design",
      "amount": 350,
      "due_on": "2026-10-20",
      "state": "approved"
     },
     {
      "job_id": 2,
      "title": "Clickable prototype",
      "amount": 1500,
      "due_on": "2026-12-01",
      "state": "draft"
     }
    ]
   },
   {
    "name": "Dispute",
    "fields": [
     {
      "name": "milestone_id",
      "references": "Milestone",
      "on_delete": "cascade"
     },
     {
      "name": "reason",
      "type": "text"
     },
     {
      "name": "status",
      "choices": [
       "open",
       "under_review",
       "resolved_client",
       "resolved_freelancer"
      ],
      "transitions": {
       "open": [
        "under_review"
       ],
       "under_review": [
        "resolved_client",
        "resolved_freelancer"
       ]
      }
     }
    ],
    "sample_rows": [
     {
      "milestone_id": 1,
      "reason": "Homepage does not match the approved mockup.",
      "status": "under_review"
     },
     {
      "milestone_id": 2,
      "reason": "Deadline moved without notice.",
      "status": "open"
     },
     {
      "milestone_id": 4,
      "reason": "Two menu items missing.",
      "status": "resolved_freelancer"
     }
    ]
   }
  ],
  "actions": [
   {
    "name": "deposit",
    "entity": "Wallet",
    "path": "/{item_id}/deposit",
    "kind": "adjust",
    "description": "Add money to the wallet.",
    "rules": [],
    "roles": [],
    "inputs": [],
    "direction": "add",
    "field": "available_balance"
   },
   {
    "name": "withdraw",
    "entity": "Wallet",
    "path": "/{item_id}/withdraw",
    "kind": "adjust",
    "description": "Take money out.",
    "rules": [
     "409 if the available balance is too low"
    ],
    "roles": [],
    "inputs": [],
    "direction": "subtract",
    "field": "available_balance"
   },
   {
    "name": "lock_escrow",
    "entity": "Wallet",
    "path": "/{item_id}/lock-escrow",
    "kind": "move",
    "description": "Fund a milestone: money moves into escrow.",
    "rules": [
     "409 if the available balance is too low"
    ],
    "roles": [],
    "inputs": [],
    "direction": "add",
    "field": "available_balance",
    "target": "escrow_balance"
   },
   {
    "name": "release_escrow",
    "entity": "Wallet",
    "path": "/{item_id}/release-escrow",
    "kind": "move",
    "description": "Money comes back out of escrow.",
    "rules": [
     "409 if escrow holds less than the amount"
    ],
    "roles": [],
    "inputs": [],
    "direction": "add",
    "field": "escrow_balance",
    "target": "available_balance"
   },
