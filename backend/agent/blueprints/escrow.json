{
 "id": "escrow",
 "title": "Freelance escrow marketplace",
 "keywords": [
  "freelance",
  "escrow",
  "wallet",
  "milestone",
  "bid",
  "marketplace",
  "gig",
  "payout"
 ],
 "summary": "Clients post jobs, freelancers bid, milestones are funded into escrow and released; wallets and disputes.",
 "prompt": "A freelance marketplace with escrow: clients post jobs, freelancers bid, accepted work is split into milestones funded into escrow, released on approval, with wallets, deposits, withdrawals and disputes.",
 "spec": {
  "project_name": "freelance_escrow",
  "description": "Freelance marketplace with wallets, escrow milestones and disputes.",
  "auth": true,
  "features": [
   "audit_log",
   "rate_limit"
  ],
  "roles": [
   {
    "name": "client"
   },
   {
    "name": "freelancer"
   },
   {
    "name": "dispute_admin",
    "self_signup": false
   }
  ],
  "entities": [
   {
    "name": "Wallet",
    "write_access": "owner",
    "fields": [
     {
      "name": "label"
     },
     {
      "name": "currency",
      "choices": [
       "USD",
       "EUR",
       "INR"
      ]
     },
     {
      "name": "available_balance",
      "type": "decimal",
      "min": 0
     },
     {
      "name": "escrow_balance",
      "type": "decimal",
      "min": 0
     }
    ],
    "sample_rows": [
     {
      "label": "Acme Studio",
      "currency": "USD",
      "available_balance": 5200,
      "escrow_balance": 1800
     },
     {
      "label": "Nova Apps",
      "currency": "EUR",
      "available_balance": 2400,
      "escrow_balance": 600
     },
     {
      "label": "Riya Designs",
      "currency": "INR",
      "available_balance": 86000,
      "escrow_balance": 0
     },
     {
      "label": "Kite Labs",
      "currency": "USD",
      "available_balance": 950,
      "escrow_balance": 3000
     },
     {
      "label": "Sam (freelancer)",
      "currency": "USD",
      "available_balance": 1320,
      "escrow_balance": 0
     }
    ]
   },
   {
    "name": "Job",
    "write_roles": [
     "client"
    ],
    "fields": [
     {
      "name": "title",
      "index": true
     },
     {
      "name": "description",
      "type": "text"
     },
     {
      "name": "budget",
      "type": "decimal",
      "min": 0
     },
     {
      "name": "category",
      "choices": [
       "web",
       "mobile",
       "design",
       "data",
       "writing"
      ]
     },
     {
      "name": "status",
      "choices": [
       "open",
       "in_progress",
       "completed",
       "cancelled"
      ],
      "transitions": {
       "open": [
        "in_progress",
        "cancelled"
       ],
       "in_progress": [
        "completed",
        "cancelled"
       ]
      }
     }
    ],
    "sample_rows": [
     {
      "title": "Shopify store redesign",
      "description": "Refresh the theme and checkout.",
      "budget": 2400,
      "category": "web",
      "status": "in_progress"
     },
     {
      "title": "iOS habit tracker MVP",
      "description": "SwiftUI app with streaks.",
      "budget": 6000,
      "category": "mobile",
      "status": "open"
     },
     {
      "title": "Brand identity for a cafe",
      "description": "Logo, palette, menu.",
      "budget": 900,
      "category": "design",
      "status": "completed"
     },
     {
      "title": "Sales dashboard in Metabase",
      "description": "Connect Postgres, 6 charts.",
      "budget": 1500,
      "category": "data",
      "status": "open"
     },
     {
      "title": "Technical blog series",
      "description": "Four posts on Kubernetes.",
      "budget": 800,
      "category": "writing",
      "status": "cancelled"
     }
    ]
   },
   {
    "name": "Bid",
    "write_roles": [
     "freelancer"
    ],
    "fields": [
     {
      "name": "job_id",
      "references": "Job",
      "on_delete": "cascade"
     },
     {
      "name": "amount",
      "type": "decimal",
      "min": 1
     },
     {
      "name": "days",
      "type": "int",
      "min": 1,
      "max": 365
     },
     {
      "name": "cover_letter",
      "type": "text"
     },
     {
      "name": "status",
      "choices": [
       "pending",
       "accepted",
       "rejected",
       "withdrawn"
      ],
      "transitions": {
       "pending": [
        "accepted",
        "rejected",
        "withdrawn"
       ]
      }
     }
    ],
    "sample_rows": [
     {
      "job_id": 1,
      "amount": 2200,
      "days": 14,
      "cover_letter": "I have shipped 30+ Shopify stores.",
      "status": "accepted"
     },
     {
      "job_id": 2,
      "amount": 5800,
      "days": 45,
      "cover_letter": "SwiftUI specialist, see my App Store apps.",
      "status": "pending"
     },
     {
      "job_id": 2,
      "amount": 6500,
      "days": 30,
      "cover_letter": "Team of two, faster delivery.",
      "status": "pending"
     },
     {
      "job_id": 4,
      "amount": 1400,
      "days": 10,
      "cover_letter": "Metabase and dbt every day.",
      "status": "pending"
     },
     {
      "job_id": 3,
      "amount": 850,
      "days": 7,
      "cover_letter": "Branding for 12 cafes so far.",
      "status": "accepted"
     }
    ]
