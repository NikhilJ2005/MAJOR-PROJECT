"""The audit log, read-only and for admins. There are no routes that change or delete entries."""

from fastapi import APIRouter, Depends, Query
from sqlalchemy import select
from sqlalchemy.orm import Session

from app.database import get_db
from app.errors import ApiError
from app.models.audit_log import AuditLog
from app.models.user import User
from app.security import get_current_user, require_admin

router = APIRouter(prefix="/audit_logs", tags=["audit"])


def _entry(row: AuditLog) -> dict:
    return {
        "id": row.id, "actor_id": row.actor_id, "action": row.action, "entity": row.entity, "row_id": row.row_id,
        "before": row.before, "after": row.after, "request_id": row.request_id, "created_at": row.created_at.isoformat(),
    }


@router.get("/")
def list_audit_logs(
    entity: str | None = None,
    row_id: int | None = None,
    skip: int = Query(0, ge=0),
    limit: int = Query(50, ge=1, le=100),
    db: Session = Depends(get_db),
    user: User = Depends(get_current_user),
) -> list[dict]:
    require_admin(user)
    stmt = select(AuditLog)
    if entity:
        stmt = stmt.where(AuditLog.entity == entity)
    if row_id is not None:
        stmt = stmt.where(AuditLog.row_id == row_id)
    return [_entry(row) for row in db.scalars(stmt.order_by(AuditLog.id.desc()).offset(skip).limit(limit))]


@router.get("/{entry_id}")
def get_audit_log(entry_id: int, db: Session = Depends(get_db), user: User = Depends(get_current_user)) -> dict:
    require_admin(user)
    row = db.get(AuditLog, entry_id)
    if row is None:
        raise ApiError(404, "audit log entry not found")
    return _entry(row)
