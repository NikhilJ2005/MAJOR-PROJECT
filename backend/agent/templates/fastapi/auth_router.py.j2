{% set refresh = spec.has("refresh_tokens") %}{% set audit = spec.has("audit_log") %}{% set limit = spec.has("rate_limit") %}
"""Register, log in, "who am I"{% if refresh %}, refresh and log out{% endif %}{% if spec.roles %}, and roles{% endif %}."""

from fastapi import APIRouter, Depends, Request, Response, status  # noqa: F401
from sqlalchemy import select
from sqlalchemy.orm import Session

{% if audit %}
from app import audit
{% endif %}
{% if limit %}
from app import ratelimit
{% endif %}
{% if refresh %}
from app import tokens
{% endif %}
from app.database import get_db
from app.errors import ApiError
from app.models.user import User
from app.schemas.user import {% if refresh %}RefreshIn, {% endif %}{% if spec.roles %}RoleChange, {% endif %}Token, UserCreate, UserRead
from app.security import {% if spec.roles %}ROLES, {% endif %}create_access_token, get_current_user, hash_password, login_ok{% if spec.roles %}, require_admin, signup_role{% endif %}

router = APIRouter(prefix="/auth", tags=["auth"])


def _client(request: Request) -> str:
    return request.client.host if request.client else "unknown"


@router.post("/register", response_model=UserRead, status_code=status.HTTP_201_CREATED)
def register(payload: UserCreate, request: Request, db: Session = Depends(get_db)):
{% if limit %}
    ratelimit.hit("register", _client(request))
{% endif %}
    email = payload.email.lower()
    if db.scalar(select(User).where(User.email == email)):
        raise ApiError(409, "email already registered")
    user = User(email=email, password_hash=hash_password(payload.password){% if spec.roles %}, role=signup_role(payload.role){% endif %})
    db.add(user)
    db.commit()
    db.refresh(user)
{% if audit %}
    audit.record(db, user, "register", "User", user.id)
{% endif %}
    return user


@router.post("/login", response_model=Token)
def login(payload: UserCreate, request: Request, db: Session = Depends(get_db)):
    email = payload.email.lower()
{% if limit %}
    ratelimit.hit("login", f"{_client(request)}:{email}")
{% endif %}
    user = db.scalar(select(User).where(User.email == email))
    ok = login_ok(user, payload.password)
    db.commit()  # keeps the failed-login count
    if not ok:
{% if audit %}
        audit.record(db, user, "login_failed", "User", user.id if user else None)
{% endif %}
        raise ApiError(401, "invalid credentials")
{% if audit %}
    audit.record(db, user, "login", "User", user.id)
{% endif %}
    return Token(access_token=create_access_token(user.id){% if refresh %}, refresh_token=tokens.issue(db, user.id){% endif %})
{% if refresh %}


@router.post("/refresh", response_model=Token)
def refresh(payload: RefreshIn, db: Session = Depends(get_db)):
    """A new access token and a new refresh token; the old refresh token stops working."""
    user_id, new_refresh = tokens.rotate(db, payload.refresh_token)
    return Token(access_token=create_access_token(user_id), refresh_token=new_refresh)


@router.post("/logout", status_code=status.HTTP_204_NO_CONTENT)
def logout(payload: RefreshIn, db: Session = Depends(get_db)):
    """Revoke the refresh token (and every token rotated from the same login)."""
    tokens.revoke(db, payload.refresh_token)
    return Response(status_code=status.HTTP_204_NO_CONTENT)
{% endif %}


@router.get("/me", response_model=UserRead)
def me(user: User = Depends(get_current_user)):
    return user
{% if spec.roles %}


@router.get("/roles")
def roles() -> dict:
    return {"roles": ROLES}


@router.get("/users", response_model=list[UserRead])
def list_users(db: Session = Depends(get_db), user: User = Depends(get_current_user)):
    require_admin(user)
    return db.scalars(select(User).order_by(User.id).limit(500)).all()


@router.patch("/users/{user_id}/role", response_model=UserRead)
def change_role(user_id: int, payload: RoleChange, db: Session = Depends(get_db), user: User = Depends(get_current_user)):
    """Admins give any role, including the ones users can't pick at sign-up."""
    require_admin(user)
    if payload.role not in ROLES:
        raise ApiError(422, f"unknown role {payload.role}; choose one of: {', '.join(ROLES)}")
    target = db.get(User, user_id)
    if target is None:
        raise ApiError(404, "User not found")
    before = target.role
    target.role = payload.role
    db.commit()
    db.refresh(target)
{% if audit %}
    audit.record(db, user, "change_role", "User", target.id, {"role": before}, {"role": target.role})
{% endif %}
    return target
{% endif %}
