{% set audit = spec.has("audit_log") %}{% set limit = spec.has("rate_limit") and actions %}
"""{{ e.name }} endpoints: CRUD{% if actions %} plus custom actions{% endif %}.

Who may do what: {{ access_text(e) }}.
"""

from fastapi import APIRouter, Body, Depends, Query, Request, Response, status  # noqa: F401
from fastapi.responses import StreamingResponse  # noqa: F401
from sqlalchemy import func, select
from sqlalchemy.exc import IntegrityError
from sqlalchemy.orm import Session

from app.database import get_db
from app import events  # noqa: F401
{% if audit %}
from app import audit
{% endif %}
{% if limit %}
from app import ratelimit
{% endif %}
from app.errors import ApiError, check_transition  # noqa: F401
from app.models.{{ e.module }} import {{ e.name }}
from app.schemas.{{ e.module }} import {{ e.name }}Create, {{ e.name }}Read, {{ e.name }}Update
from app.services import {{ e.module }} as service  # noqa: F401
{% if spec.auth %}
from app.models.user import User
from app.security import get_current_user, require_admin, {% if spec.roles %}require_role, {% endif %}user_id_from_header  # noqa: F401
{% endif %}

router = APIRouter(prefix="/{{ e.table }}", tags=["{{ e.name }}"])


def _get_or_404(db: Session, item_id: int{% if e.owned %}, user: User{% endif %}, lock: bool = False) -> {{ e.name }}:
    """The row, or 404. lock=True: SELECT ... FOR UPDATE, so concurrent changes wait for this transaction."""
    obj = db.get({{ e.name }}, item_id, with_for_update=lock or None)
{% if e.owned %}
    if obj is None or obj.owner_id != user.id:  # other users' rows look like they don't exist
{% else %}
    if obj is None:
{% endif %}
        raise ApiError(404, "{{ e.name }} not found")
    return obj


def _row(obj: {{ e.name }}) -> dict:
    return {{ e.name }}Read.model_validate(obj).model_dump(mode="json")


def _commit(db: Session) -> None:
    try:
        db.commit()
    except IntegrityError as exc:
        db.rollback()
        raise ApiError(409, "conflicts with existing data (duplicate value or unknown reference)") from exc
{% for a in actions %}


@router.{{ a.method | lower }}("{{ a.path }}")
def {{ a.name }}_{{ e.module }}(
{% if a.on_item %}
    item_id: int,
{% endif %}
    request: Request,
{% if a.method == "POST" %}
    payload: dict = Body(default={}),
{% endif %}
    db: Session = Depends(get_db),
{% if spec.auth %}
    user: User = Depends(get_current_user),
{% endif %}
) -> dict:
    """{{ a.description }}"""
{% if a.admin_only and spec.auth %}
    require_admin(user)
{% endif %}
{% if a.roles %}
    require_role(user, {{ tojson(a.roles) }})
{% endif %}
{% if limit %}
    ratelimit.hit("action", {% if spec.auth %}str(user.id){% else %}request.client.host if request.client else "unknown"{% endif %})
{% endif %}
{% if a.method == "GET" %}
    payload = dict(request.query_params)
{% endif %}
    obj = {% if a.on_item %}_get_or_404(db, item_id{% if e.owned %}, user{% endif %}{% if a.locks %}, lock=True{% endif %}){% else %}None{% endif %}

{% if audit and a.method == "POST" %}
    before = _row(obj) if obj is not None else None
    result = service.{{ a.name }}(db, obj, payload, {% if spec.auth %}user{% else %}None{% endif %})
    audit.record(db, {% if spec.auth %}user{% else %}None{% endif %}, "{{ a.name }}", "{{ e.name }}", {% if a.on_item %}item_id{% else %}None{% endif %}, before, result)
    return result
{% else %}
    return service.{{ a.name }}(db, obj, payload, {% if spec.auth %}user{% else %}None{% endif %})
{% endif %}
{% endfor %}


{% if e.realtime %}
@router.get("/stream")
def stream_{{ e.table }}(replay: bool = False{% if e.owned %}, token: str = ""{% endif %}):
    """Live changes as Server-Sent Events. ?replay=1 returns the recent events and ends."""
{% if e.owned %}
    owner_id = user_id_from_header(f"Bearer {token}")  # browsers can't send headers on EventSource
    if owner_id is None:
        raise ApiError(401, "pass your login token as ?token=")
{% endif %}
    return StreamingResponse(
        events.stream("{{ e.table }}", {% if e.owned %}owner_id{% else %}None{% endif %}, replay), media_type="text/event-stream"
    )


{% endif %}
@router.post("/", response_model={{ e.name }}Read, status_code=status.HTTP_201_CREATED)
def create_{{ e.module }}(
    payload: {{ e.name }}Create,
    db: Session = Depends(get_db),
{% if spec.auth %}
    user: User = Depends(get_current_user),
{% endif %}
):
{% if e.write_access == "admin" %}
    require_admin(user)
{% endif %}
{% if e.write_roles %}
    require_role(user, {{ tojson(e.write_roles) }})
{% endif %}
    obj = {{ e.name }}(**payload.model_dump(){% if e.owned %}, owner_id=user.id{% endif %})
    db.add(obj)
    _commit(db)
    db.refresh(obj)
{% if audit %}
    audit.record(db, user, "create", "{{ e.name }}", obj.id, None, _row(obj))
{% endif %}
{% if e.realtime %}
    events.publish("{{ e.table }}", "created", _row(obj))
{% endif %}
    return obj


@router.get("/", response_model=list[{{ e.name }}Read])
def list_{{ e.table }}(
    response: Response,
    skip: int = Query(0, ge=0),
    limit: int = Query(50, ge=1, le=100),
{% if search_field %}
    q: str | None = Query(None, description="Search in {{ search_field }}"),
{% endif %}
{% for fk in e.foreign_keys %}
    {{ fk.name }}: int | None = Query(None, description="Only items with this {{ fk.name }}"),
{% endfor %}
    db: Session = Depends(get_db),
{% if e.owned %}
    user: User = Depends(get_current_user),
{% endif %}
):
    stmt = select({{ e.name }})
{% if e.owned %}
    stmt = stmt.where({{ e.name }}.owner_id == user.id)
{% endif %}
{% if search_field %}
    if q:
        stmt = stmt.where({{ e.name }}.{{ search_field }}.ilike(f"%{q}%"))
{% endif %}
{% for fk in e.foreign_keys %}
    if {{ fk.name }} is not None:
        stmt = stmt.where({{ e.name }}.{{ fk.name }} == {{ fk.name }})
{% endfor %}
    response.headers["X-Total-Count"] = str(db.scalar(select(func.count()).select_from(stmt.subquery())))
    return db.scalars(stmt.order_by({{ e.name }}.id).offset(skip).limit(limit)).all()


@router.get("/{item_id}", response_model={{ e.name }}Read)
def get_{{ e.module }}(
    item_id: int,
    db: Session = Depends(get_db),
{% if e.owned %}
    user: User = Depends(get_current_user),
{% endif %}
):
    return _get_or_404(db, item_id{% if e.owned %}, user{% endif %})


@router.patch("/{item_id}", response_model={{ e.name }}Read)
def update_{{ e.module }}(
    item_id: int,
    payload: {{ e.name }}Update,
    db: Session = Depends(get_db),
{% if spec.auth %}
    user: User = Depends(get_current_user),
{% endif %}
):
{% if e.write_access == "admin" %}
    require_admin(user)
{% endif %}
{% if e.write_roles %}
    require_role(user, {{ tojson(e.write_roles) }})
{% endif %}
    obj = _get_or_404(db, item_id{% if e.owned %}, user{% endif %})
    changes = payload.model_dump(exclude_unset=True)
{% if audit %}
    before = _row(obj)
{% endif %}
{% for f in transition_fields(e) %}
    check_transition("{{ f.name }}", obj.{{ f.name }}, changes.get("{{ f.name }}"), {{ tojson(f.transitions) }})
{% endfor %}
    for key, value in changes.items():
        setattr(obj, key, value)
    _commit(db)
    db.refresh(obj)
{% if audit %}
    audit.record(db, user, "update", "{{ e.name }}", obj.id, before, _row(obj))
{% endif %}
{% if e.realtime %}
    events.publish("{{ e.table }}", "updated", _row(obj))
{% endif %}
    return obj


@router.delete("/{item_id}", status_code=status.HTTP_204_NO_CONTENT)
def delete_{{ e.module }}(
    item_id: int,
    db: Session = Depends(get_db),
{% if spec.auth %}
    user: User = Depends(get_current_user),
{% endif %}
):
{% if e.write_access == "admin" %}
    require_admin(user)
{% endif %}
{% if e.write_roles %}
    require_role(user, {{ tojson(e.write_roles) }})
{% endif %}
    obj = _get_or_404(db, item_id{% if e.owned %}, user{% endif %})
{% if e.realtime or audit %}
    row = _row(obj)
{% endif %}
    db.delete(obj)
    _commit(db)
{% if audit %}
    audit.record(db, user, "delete", "{{ e.name }}", item_id, row, None)
{% endif %}
{% if e.realtime %}
    events.publish("{{ e.table }}", "deleted", row)
{% endif %}
    return Response(status_code=status.HTTP_204_NO_CONTENT)
