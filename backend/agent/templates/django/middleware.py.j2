"""One middleware for the whole API: RFC 7807 errors, CORS headers, request ids and a log line per request."""

import json
import logging
import time

from django.db import IntegrityError
from django.http import JsonResponse
from pydantic import ValidationError

from app import config, logs
from app.errors import PROBLEM_JSON, ApiError, error_headers, problem

logs.setup()
log = logging.getLogger("app")


def problem_response(status: int, detail, headers: dict | None = None) -> JsonResponse:
    response = JsonResponse(problem(status, detail), status=status, content_type=PROBLEM_JSON)
    for key, value in (headers or {}).items():
        response[key] = value
    return response


class ApiMiddleware:
    def __init__(self, get_response):
        self.get_response = get_response

    def __call__(self, request):
        start = time.perf_counter()
        rid = logs.new_request_id(request.headers.get("X-Request-ID"))
        token = logs.request_id.set(rid)
        try:
            response = self.get_response(request)
        finally:
            logs.request_id.reset(token)
        response["X-Request-ID"] = rid
        for key, value in logs.SECURITY_HEADERS.items():
            response[key] = value
        if request.headers.get("X-Forwarded-Proto", request.scheme) == "https":
            response["Strict-Transport-Security"] = logs.HSTS
        origin = request.headers.get("Origin")
        if origin and origin in config.CORS_ORIGINS:
            response["Access-Control-Allow-Origin"] = origin
            response["Access-Control-Allow-Headers"] = "Authorization, Content-Type"
            response["Access-Control-Allow-Methods"] = "GET, POST, PATCH, DELETE, OPTIONS"
        ms = (time.perf_counter() - start) * 1000
        logs.record(request.method, request.path, response.status_code, ms / 1000)
        log.info("%s %s -> %s (%.0f ms)", request.method, request.path, response.status_code, ms)
        return response

    def process_exception(self, request, exc):
        """Turn expected errors into the same problem+json shape the other frameworks use."""
        if isinstance(exc, ApiError):
            return problem_response(exc.status_code, exc.detail, error_headers(exc))
        if isinstance(exc, ValidationError):
            return problem_response(422, json.loads(exc.json(include_url=False)))
        if isinstance(exc, IntegrityError):
            return problem_response(409, "conflicts with existing data (duplicate value or unknown reference)")
        return None
