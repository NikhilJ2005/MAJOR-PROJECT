"""{{ e.name }} endpoints: CRUD{% if actions %} plus custom actions{% endif %}.

Who may do what: {{ access_text(e) }}.
"""

import json

from django.db import IntegrityError, transaction
from django.http import HttpResponse, JsonResponse, StreamingHttpResponse  # noqa: F401
from django.urls import path

from app import events  # noqa: F401
from app.errors import ApiError, check_transition  # noqa: F401
from app.models.{{ e.module }} import {{ e.name }}
from app.schemas.{{ e.module }} import {{ e.name }}Create, {{ e.name }}Read, {{ e.name }}Update
from app.services import {{ e.module }} as service  # noqa: F401
{% if spec.auth %}
from app.models.user import User
from app.security import current_user, require_admin, user_id_from_header  # noqa: F401
{% endif %}


def _json(obj: {{ e.name }}) -> dict:
    return {{ e.name }}Read.model_validate(obj).model_dump(mode="json")


def _body(request) -> dict:
    try:
        data = json.loads(request.body or b"{}")
    except ValueError:
        raise ApiError(422, "request body must be JSON") from None
    return data if isinstance(data, dict) else {}


def _int_arg(request, name: str, default: int | None = None, low: int | None = None, high: int | None = None) -> int | None:
    """An integer query parameter, with range checks (422 when invalid)."""
    raw = request.GET.get(name)
    if raw is None:
        return default
    try:
        value = int(raw)
    except ValueError:
        raise ApiError(422, f"{name} must be an integer") from None
    if (low is not None and value < low) or (high is not None and value > high):
        raise ApiError(422, f"{name} is out of range")
    return value


def _get_or_404(item_id: int{% if e.owned %}, user: User{% endif %}) -> {{ e.name }}:
    obj = {{ e.name }}.objects.filter(id=item_id).first()
{% if e.owned %}
    if obj is None or obj.owner_id != user.id:  # other users' rows look like they don't exist
{% else %}
    if obj is None:
{% endif %}
        raise ApiError(404, "{{ e.name }} not found")
    return obj


def _save(obj: {{ e.name }}) -> None:
    try:
        with transaction.atomic():
            obj.save()
    except IntegrityError as exc:
        raise ApiError(409, "conflicts with existing data (duplicate value or unknown reference)") from exc
{% for a in actions %}


def {{ a.name }}_{{ e.module }}(request{% if a.on_item %}, item_id: int{% endif %}):
    """{{ a.method }}: {{ a.description }}"""
    if request.method != "{{ a.method }}":
        raise ApiError(405, "method not allowed")
{% if spec.auth %}
    user = current_user(request)
{% endif %}
{% if a.admin_only and spec.auth %}
    require_admin(user)
{% endif %}
    payload = {% if a.method == "GET" %}request.GET.dict(){% else %}_body(request){% endif %}

    obj = {% if a.on_item %}_get_or_404(item_id{% if e.owned %}, user{% endif %}){% else %}None{% endif %}

    return JsonResponse(service.{{ a.name }}(obj, payload, {% if spec.auth %}user{% else %}None{% endif %}), safe=False)
{% endfor %}


def collection(request):
    """/{{ e.table }}/ : GET lists, POST creates."""
    if request.method == "GET":
        return _list(request)
    if request.method == "POST":
        return _create(request)
    raise ApiError(405, "method not allowed")


def item(request, item_id: int):
    """/{{ e.table }}/<id> : GET reads, PATCH updates, DELETE deletes."""
    if request.method == "GET":
        return _read(request, item_id)
    if request.method == "PATCH":
        return _update(request, item_id)
    if request.method == "DELETE":
        return _delete(request, item_id)
    raise ApiError(405, "method not allowed")


def _create(request):
{% if spec.auth %}
    user = current_user(request)
{% endif %}
{% if e.write_access == "admin" %}
    require_admin(user)
{% endif %}
    payload = {{ e.name }}Create.model_validate(_body(request))
    obj = {{ e.name }}(**payload.model_dump(){% if e.owned %}, owner_id=user.id{% endif %})
    _save(obj)
{% if e.realtime %}
    events.publish("{{ e.table }}", "created", _json(obj))
{% endif %}
    return JsonResponse(_json(obj), status=201)


def _list(request):
{% if e.owned %}
    user = current_user(request)
{% endif %}
    skip = _int_arg(request, "skip", 0, low=0)
    limit = _int_arg(request, "limit", 50, low=1, high=100)
    rows = {{ e.name }}.objects.all()
{% if e.owned %}
    rows = rows.filter(owner_id=user.id)
{% endif %}
{% if search_field %}
    q = request.GET.get("q")
    if q:
        rows = rows.filter({{ search_field }}__icontains=q)
{% endif %}
{% for fk in e.foreign_keys %}
    {{ fk.name }} = _int_arg(request, "{{ fk.name }}")
    if {{ fk.name }} is not None:
        rows = rows.filter({{ fk.name }}={{ fk.name }})
{% endfor %}
    response = JsonResponse([_json(row) for row in rows.order_by("id")[skip : skip + limit]], safe=False)
    response["X-Total-Count"] = str(rows.count())
    return response


def _read(request, item_id: int):
{% if e.owned %}
    user = current_user(request)
{% endif %}
    return JsonResponse(_json(_get_or_404(item_id{% if e.owned %}, user{% endif %})))


def _update(request, item_id: int):
{% if spec.auth %}
    user = current_user(request)
{% endif %}
{% if e.write_access == "admin" %}
    require_admin(user)
{% endif %}
    obj = _get_or_404(item_id{% if e.owned %}, user{% endif %})
    changes = {{ e.name }}Update.model_validate(_body(request)).model_dump(exclude_unset=True)
{% for f in transition_fields(e) %}
    check_transition("{{ f.name }}", obj.{{ f.name }}, changes.get("{{ f.name }}"), {{ tojson(f.transitions) }})
{% endfor %}
    for key, value in changes.items():
        setattr(obj, key, value)
    _save(obj)
{% if e.realtime %}
    events.publish("{{ e.table }}", "updated", _json(obj))
{% endif %}
    return JsonResponse(_json(obj))


def _delete(request, item_id: int):
{% if spec.auth %}
    user = current_user(request)
{% endif %}
{% if e.write_access == "admin" %}
    require_admin(user)
{% endif %}
    obj = _get_or_404(item_id{% if e.owned %}, user{% endif %})
{% if e.realtime %}
    row = _json(obj)
{% endif %}
    obj.delete()  # a restricted parent raises RestrictedError (an IntegrityError) -> 409 in the middleware
{% if e.realtime %}
    events.publish("{{ e.table }}", "deleted", row)
{% endif %}
    return HttpResponse(status=204)
{% if e.realtime %}


def stream_{{ e.table }}(request):
    """Live changes as Server-Sent Events. ?replay=1 returns the recent events and ends."""
    replay = request.GET.get("replay") in ("1", "true")
{% if e.owned %}
    owner_id = user_id_from_header(f"Bearer {request.GET.get('token', '')}")  # EventSource can't send headers
    if owner_id is None:
        raise ApiError(401, "pass your login token as ?token=")
{% endif %}
    return StreamingHttpResponse(
        events.stream("{{ e.table }}", {% if e.owned %}owner_id{% else %}None{% endif %}, replay), content_type="text/event-stream"
    )
{% endif %}


urlpatterns = [
{% for a in actions %}
    path("{{ e.table }}{{ a.path | replace('{item_id}', '<int:item_id>') }}", {{ a.name }}_{{ e.module }}),
{% endfor %}
{% if e.realtime %}
    path("{{ e.table }}/stream", stream_{{ e.table }}),
{% endif %}
    path("{{ e.table }}/", collection),
    path("{{ e.table }}/<int:item_id>", item),
]
