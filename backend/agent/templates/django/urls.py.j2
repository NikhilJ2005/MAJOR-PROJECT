"""URL routes: every entity's urlpatterns plus health checks and API docs."""

from pathlib import Path

from django.db import connection
from django.http import HttpResponse, JsonResponse
from django.urls import path

from app import logs
from app.middleware import problem_response
{% if spec.auth %}
from app.routers import auth
{% endif %}
{% if spec.has("audit_log") %}
from app.routers import audit
{% endif %}
{% for e in spec.entities %}
from app.routers import {{ e.module }}
{% endfor %}

HERE = Path(__file__).parent


def health(request):
    return JsonResponse({"status": "ok"})


def ready(request):
    try:
        connection.ensure_connection()
    except Exception:  # noqa: BLE001 - any failure means "not ready"
        return problem_response(503, "database unavailable")
    return JsonResponse({"status": "ready"})


def metrics(request):
    """Requests by route and status, for Prometheus."""
    return HttpResponse(logs.metrics_text(), content_type="text/plain")


def openapi(request):
    return HttpResponse((HERE / "openapi.json").read_text(), content_type="application/json")


def docs(request):
    return HttpResponse((HERE / "docs.html").read_text(), content_type="text/html")


CONTENT_TYPES = {".js": "text/javascript", ".json": "application/json", ".html": "text/html", ".css": "text/css"}


def frontend(request):
    """The generated web app; it calls this API with relative URLs."""
    return HttpResponse((HERE / "static" / "index.html").read_text(), content_type="text/html")


def static_file(request, name: str):
    path = (HERE / "static" / name).resolve()
    if (HERE / "static").resolve() not in path.parents or not path.is_file():
        return not_found(request)
    return HttpResponse(path.read_bytes(), content_type=CONTENT_TYPES.get(path.suffix, "application/octet-stream"))


def not_found(request, exception=None):
    return problem_response(404, "not found")


handler404 = not_found

urlpatterns = [
    path("", frontend),
    path("static/<path:name>", static_file),
    path("health", health),
    path("ready", ready),
    path("metrics", metrics),
    path("openapi.json", openapi),
    path("docs", docs),
{% if spec.auth %}
    *auth.urlpatterns,
{% endif %}
{% if spec.has("audit_log") %}
    *audit.urlpatterns,
{% endif %}
{% for e in spec.entities %}
    *{{ e.module }}.urlpatterns,
{% endfor %}
]
