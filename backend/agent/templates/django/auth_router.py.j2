"""Register, log in, and "who am I"."""

import json

from django.http import JsonResponse
from django.urls import path

from app.errors import ApiError
from app.models.user import User
from app.schemas.user import Token, UserCreate, UserRead
from app.security import create_access_token, current_user, hash_password, verify_password


def _credentials(request) -> UserCreate:
    try:
        data = json.loads(request.body or b"{}")
    except ValueError:
        data = {}
    return UserCreate.model_validate(data if isinstance(data, dict) else {})


def register(request):
    if request.method != "POST":
        raise ApiError(405, "method not allowed")
    payload = _credentials(request)
    email = payload.email.lower()
    if User.objects.filter(email=email).exists():
        raise ApiError(409, "email already registered")
    user = User.objects.create(email=email, password_hash=hash_password(payload.password))
    return JsonResponse(UserRead.model_validate(user).model_dump(mode="json"), status=201)


def login(request):
    if request.method != "POST":
        raise ApiError(405, "method not allowed")
    payload = _credentials(request)
    user = User.objects.filter(email=payload.email.lower()).first()
    if user is None or not verify_password(payload.password, user.password_hash):
        raise ApiError(401, "invalid credentials")
    return JsonResponse(Token(access_token=create_access_token(user.id)).model_dump())


def me(request):
    return JsonResponse(UserRead.model_validate(current_user(request)).model_dump(mode="json"))


urlpatterns = [
    path("auth/register", register),
    path("auth/login", login),
    path("auth/me", me),
]
