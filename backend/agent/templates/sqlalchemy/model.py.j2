from datetime import date, datetime, timezone  # noqa: F401

from sqlalchemy import JSON, Boolean, Date, DateTime, Float, ForeignKey, Integer, Numeric, String, Text  # noqa: F401
from sqlalchemy.orm import Mapped, mapped_column

from app.database import Base


class {{ e.name }}(Base):
    __tablename__ = "{{ e.table }}"

    id: Mapped[int] = mapped_column(Integer, primary_key=True, index=True)
{% if e.owned %}
    owner_id: Mapped[int] = mapped_column(Integer, ForeignKey("users.id", ondelete="CASCADE"), index=True, nullable=False)
{% endif %}
{% for f in e.fields %}
    {{ f.name }}: Mapped[{{ sa_py_type(f) }}{% if not f.required %} | None{% endif %}] = mapped_column({{ sa_type(f) }}, {{ sa_column_args(f) }})
{% endfor %}
    created_at: Mapped[datetime] = mapped_column(DateTime(timezone=True), default=lambda: datetime.now(timezone.utc))
