def test_account_lockout(client):
    """5 wrong passwords in a row lock the account (423), even for the right password."""
    creds = {"email": "lockout@example.com", "password": PASSWORD}
    client.post("/auth/register", json=creds)
    for _ in range(5):
        assert client.post("/auth/login", json={**creds, "password": "wrong-pass-123"}).status_code == 401
    r = client.post("/auth/login", json=creds)
    assert r.status_code == 423, r.text
