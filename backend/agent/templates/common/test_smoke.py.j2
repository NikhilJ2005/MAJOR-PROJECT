def test_login_is_rate_limited(client):
    from app import ratelimit

    saved = ratelimit.ENABLED, dict(ratelimit.LIMITS)
    ratelimit.ENABLED, ratelimit.LIMITS["login"] = True, (2, 60)
    try:
        creds = {"email": "too-many-logins@example.com", "password": "wrong-pass-123"}
        codes = [client.post("/auth/login", json=creds).status_code for _ in range(3)]
        assert codes == [401, 401, 429], codes
        r = client.post("/auth/login", json=creds)
        assert r.status_code == 429 and int(r.headers["retry-after"]) >= 1
    finally:
        ratelimit.ENABLED = saved[0]
        ratelimit.LIMITS.update(saved[1])
