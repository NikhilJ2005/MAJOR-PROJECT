ROLES = {{ tojson(spec.role_names) }}
SIGNUP_ROLES = {{ tojson(spec.roles | selectattr("self_signup") | map(attribute="name") | list) }}
ROLE_ENTITIES = [e for e in ENTITIES if e["roles"]]
ROLE_ACTIONS = {{ role_actions_json }}


def test_sign_up_roles(client, user_headers):
    r = client.post("/auth/register", json={"email": "picks-a-role@example.com", "password": PASSWORD, "role": SIGNUP_ROLES[-1]})
    assert r.status_code == 201, r.text
    assert r.json()["role"] == SIGNUP_ROLES[-1]
    r = client.post("/auth/register", json={"email": "bad-role@example.com", "password": PASSWORD, "role": "no-such-role"})
    assert r.status_code == 422, r.text
    for role in [r for r in ROLES if r not in SIGNUP_ROLES]:  # given by admins only
        r = client.post("/auth/register", json={"email": f"wants-{role}@example.com", "password": PASSWORD, "role": role})
        assert r.status_code == 403, r.text
    me = client.get("/auth/me", headers=user_headers).json()
    assert me["role"] == SIGNUP_ROLES[0]
    r = client.patch(f"/auth/users/{me['id']}/role", json={"role": ROLES[-1]}, headers=user_headers)
    assert r.status_code == 403, r.text


@pytest.mark.parametrize("entity", ROLE_ENTITIES, ids=[e["name"] for e in ROLE_ENTITIES])
def test_write_roles(client, entity, role_headers):
    """Only the entity's roles may create rows; any other role gets 403."""
    base, payload = f"/{entity['table']}", _resolve(entity["payload"])
    denied = [r for r in ROLES if r not in entity["roles"]]
    if denied:
        r = client.post(f"{base}/", json=payload, headers=role_headers(denied[0]))
        assert r.status_code == 403, r.text
    allowed = role_headers(entity["roles"][0])
    r = client.post(f"{base}/", json=payload, headers=allowed)
    assert r.status_code in (201, 409), r.text  # 409: a unique value test_crud's row already has
    if r.status_code == 201:
        assert client.delete(f"{base}/{r.json()['id']}", headers=allowed).status_code == 204


@pytest.mark.parametrize("action", ROLE_ACTIONS, ids=[a["name"] for a in ROLE_ACTIONS])
def test_action_roles(client, action, role_headers):
    denied = [r for r in ROLES if r not in action["roles"]]
    if not denied:
        pytest.skip("every role may call it")
    headers = role_headers(denied[0])
    r = client.post(action["url"], json={}, headers=headers) if action["method"] == "POST" else client.get(action["url"], headers=headers)
    assert r.status_code == 403, r.text
