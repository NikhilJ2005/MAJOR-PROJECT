def test_audit_log(client, user_headers, admin_headers):
    """Every change is recorded; admins can read the log, nobody can change it."""
    entity = ENTITIES[0]
    r = client.get("/audit_logs/", params={"entity": entity["name"]}, headers=admin_headers)
    assert r.status_code == 200, r.text
    entries = r.json()
    assert "create" in {e["action"] for e in entries}, entries
    assert client.get("/audit_logs/", headers=user_headers).status_code == 403
    entry = entries[0]
    assert client.patch(f"/audit_logs/{entry['id']}", json={"action": "x"}, headers=admin_headers).status_code == 405
    assert client.delete(f"/audit_logs/{entry['id']}", headers=admin_headers).status_code == 405
    assert client.post("/audit_logs/", json={}, headers=admin_headers).status_code == 405
