def test_rate_limit():
    """Over the limit: 429 with Retry-After."""
    from app import ratelimit
    from app.errors import ApiError

    saved = ratelimit.ENABLED, dict(ratelimit.LIMITS)
    ratelimit.ENABLED, ratelimit.LIMITS["action"] = True, (2, 60)
    try:
        ratelimit.hit("action", "rate-test")
        ratelimit.hit("action", "rate-test")
        with pytest.raises(ApiError) as caught:
            ratelimit.hit("action", "rate-test")
        assert caught.value.status_code == 429
        assert int(caught.value.headers["Retry-After"]) >= 1
    finally:
        ratelimit.ENABLED = saved[0]
        ratelimit.LIMITS.update(saved[1])
