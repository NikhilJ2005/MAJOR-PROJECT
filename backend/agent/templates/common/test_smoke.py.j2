"""Contract tests derived from the project spec (not from the generated code).

They define what every generated API must do, whatever the framework:
POST / -> 201, GET / -> list, GET /{id}, PATCH /{id}, DELETE /{id} -> 204,
401 without a token, 403 for non-admins on admin data, 404 for other users' private rows,
RFC 7807 error bodies and request ids{% if spec.roles %}, roles{% endif %}{% for f in spec.features if f in features_known %}, {{ f | replace("_", " ") }}{% endfor %}.
"""

import pytest

ENTITIES = {{ entities_json }}
AUTH = {{ spec.auth | string }}
PASSWORD = "s3cret-pass-123"

state: dict = {"ids": {}}


def test_health(client):
    r = client.get("/health")
    assert r.status_code == 200
    assert r.json()["status"] == "ok"


def test_openapi(client):
