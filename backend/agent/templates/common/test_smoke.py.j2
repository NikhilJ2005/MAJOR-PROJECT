DELETE_RULES = {{ delete_rules_json }}


def test_delete_rules(client, user_headers, admin_headers):
    """Deleting a parent that still has children: restrict -> 409, cascade -> children go too, set_null -> unlinked."""
    by_name = {e["name"]: e for e in ENTITIES}
    for rule in DELETE_RULES:
        parent_id, child_id = state["ids"].get(rule["parent"]), state["ids"].get(rule["child"])
        if parent_id is None or child_id is None:
            continue
        parent_headers = _writer(by_name[rule["parent"]], user_headers, admin_headers)
        child_headers = _writer(by_name[rule["child"]], user_headers, admin_headers)
        r = client.delete(f"/{rule['parent_table']}/{parent_id}", headers=parent_headers)
        if rule["on_delete"] == "restrict":
            assert r.status_code == 409, r.text
            continue
        assert r.status_code == 204, r.text
        state["ids"].pop(rule["parent"])
        child = client.get(f"/{rule['child_table']}/{child_id}", headers=child_headers)
        if rule["on_delete"] == "cascade":
            assert child.status_code == 404, child.text
            state["ids"].pop(rule["child"])
        else:
            assert child.json()[rule["field"]] is None


def test_delete_all(client, user_headers, admin_headers):
    for entity in reversed(ENTITIES):
        item_id = state["ids"].get(entity["name"])
        if item_id is None:
            continue
        headers = _writer(entity, user_headers, admin_headers)
        r = client.delete(f"/{entity['table']}/{item_id}", headers=headers)
        assert r.status_code == 204, r.text
        assert client.get(f"/{entity['table']}/{item_id}", headers=headers).status_code == 404
