@pytest.mark.skipif(not AUTH, reason="auth disabled in spec")
def test_auth_flow(client, user_headers):
    creds = {"email": "smoke@example.com", "password": "s3cret-pass"}
    assert client.post("/auth/register", json=creds).status_code == 201
    assert client.post("/auth/register", json=creds).status_code == 409
    assert client.post("/auth/login", json={**creds, "password": "wrong-pass"}).status_code == 401
    r = client.get("/auth/me", headers=user_headers)
    assert r.status_code == 200, r.text
    state["ids"]["User"] = r.json()["id"]
    assert client.get("/auth/me").status_code == 401
    assert client.get("/auth/me", headers={"Authorization": "Bearer not-a-token"}).status_code == 401


def _resolve(payload: dict) -> dict:
    out = {}
    for key, value in payload.items():
        if isinstance(value, str) and value.startswith("@ref:"):
            if value[5:] not in state["ids"]:
                pytest.skip(f"needs a {value[5:]}, whose test failed earlier")
            out[key] = state["ids"][value[5:]]
        else:
            out[key] = value
    return out


def _writer(entity, user_headers, admin_headers) -> dict:
    """Who may create rows of this entity (admins may do everything, whatever roles it needs)."""
    return admin_headers if entity["access"] == "admin" or entity["roles"] else user_headers


def test_errors_are_problem_details(client, user_headers, admin_headers):
    """Errors follow RFC 7807: {"type", "title", "status", "detail"} as application/problem+json."""
    entity = ENTITIES[0]
    r = client.get(f"/{entity['table']}/999999", headers=_writer(entity, user_headers, admin_headers))
    assert r.status_code == 404, r.text
    body = r.json()
    assert body["status"] == 404 and body["title"] and body["detail"], body
    assert r.headers["content-type"].startswith("application/problem+json")


def test_request_id_is_echoed(client):
    r = client.get("/health", headers={"X-Request-ID": "trace-123"})
    assert r.headers["x-request-id"] == "trace-123"
    assert client.get("/health").headers["x-request-id"]


@pytest.mark.parametrize("entity", ENTITIES, ids=[e["name"] for e in ENTITIES])
def test_crud(client, entity, user_headers, other_headers, admin_headers):
    base = f"/{entity['table']}"
    headers = _writer(entity, user_headers, admin_headers)
    payload = _resolve(entity["payload"])
    if AUTH:
        assert client.post(f"{base}/", json=payload).status_code == 401
        if entity["access"] == "admin":
            assert client.post(f"{base}/", json=payload, headers=user_headers).status_code == 403

    r = client.post(f"{base}/", json=payload, headers=headers)
    assert r.status_code == 201, r.text
    item = r.json()
    assert "id" in item
    state["ids"][entity["name"]] = item["id"]

    r = client.get(f"{base}/{item['id']}", headers=headers)
    assert r.status_code == 200, r.text

    r = client.get(f"{base}/", headers=headers)
    assert r.status_code == 200, r.text
    assert any(row["id"] == item["id"] for row in r.json())

    if entity["access"] == "owner":
        assert client.get(f"{base}/{item['id']}", headers=other_headers).status_code == 404
        assert all(row["id"] != item["id"] for row in client.get(f"{base}/", headers=other_headers).json())
        assert client.delete(f"{base}/{item['id']}", headers=other_headers).status_code == 404

    if entity["transition"]:  # state machine: a forbidden change is refused, an allowed one works
        t = entity["transition"]
        r = client.patch(f"{base}/{item['id']}", json={t["field"]: t["forbidden"]}, headers=headers)
        assert r.status_code == 409, r.text
        r = client.patch(f"{base}/{item['id']}", json={t["field"]: t["allowed"]}, headers=headers)
        assert r.status_code == 200, r.text

    if entity["realtime"]:  # the change was published as a live event
        stream_params = {"replay": 1, **({"token": headers["Authorization"][7:]} if headers else {})}
        r = client.get(f"{base}/stream", params=stream_params)
        assert r.status_code == 200, r.text
        assert '"created"' in r.text and f'"id": {item["id"]}' in r.text

    r = client.patch(f"{base}/{item['id']}", json=entity["update"], headers=headers)
    assert r.status_code == 200, r.text
    for key, value in entity["update"].items():
        assert r.json()[key] == value

    assert client.get(f"{base}/999999", headers=headers).status_code == 404


@pytest.mark.parametrize("entity", ENTITIES, ids=[e["name"] for e in ENTITIES])
def test_invalid_input_is_rejected(client, entity, user_headers, admin_headers):
    if entity["invalid"] is None:
        pytest.skip("entity has no fields to get wrong")
    headers = _writer(entity, user_headers, admin_headers)
    r = client.post(f"/{entity['table']}/", json=entity["invalid"], headers=headers)
    assert r.status_code == 422, r.text
    assert "detail" in r.json()
    assert r.json()["status"] == 422
