# dev: tables are created automatically and a throwaway SECRET_KEY is used.
# production: run migrations, and SECRET_KEY must be set.
ENV=dev
DATABASE_URL=sqlite:///./app.db
{% if spec.auth or stack.name == "django" %}
SECRET_KEY=
{% endif %}
{% if spec.auth %}
ACCESS_TOKEN_MINUTES=60
# Comma-separated emails that get admin rights.
ADMIN_EMAILS=
{% endif %}
{% if stack.name == "django" %}
ALLOWED_HOSTS=localhost,127.0.0.1
{% endif %}
# Comma-separated origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO
