# dev: tables are created automatically and a throwaway SECRET_KEY is used.
# production: run migrations, and SECRET_KEY must be set.
ENV=dev
DATABASE_URL=sqlite:///./app.db
{% if spec.auth or stack.name == "django" %}
SECRET_KEY=
{% endif %}
{% if spec.auth %}
ACCESS_TOKEN_MINUTES={{ 15 if spec.has("refresh_tokens") else 60 }}
{% if spec.has("refresh_tokens") %}
REFRESH_TOKEN_DAYS=14
{% endif %}
{% if spec.has("account_lockout") %}
LOCKOUT_ATTEMPTS=5
LOCKOUT_MINUTES=15
{% endif %}
# Comma-separated emails that get admin rights.
ADMIN_EMAILS=
{% endif %}
{% if stack.name == "django" %}
ALLOWED_HOSTS=localhost,127.0.0.1
{% endif %}
# Comma-separated origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO
# json (default in production) or text
LOG_FORMAT=text
{% if spec.has("rate_limit") %}
# Rate limits as <requests>/<seconds>; set REDIS_URL to share them between server processes.
RATE_LIMIT_LOGIN=10/60
RATE_LIMIT_REGISTER=20/60
RATE_LIMIT_ACTIONS=60/60
REDIS_URL=
{% endif %}
