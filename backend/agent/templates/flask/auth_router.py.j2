"""Register, log in, and "who am I"."""

from flask import Blueprint, request
from sqlalchemy import select

from app.database import db_session
from app.errors import ApiError
from app.models.user import User
from app.schemas.user import Token, UserCreate, UserRead
from app.security import create_access_token, current_user, hash_password, verify_password

bp = Blueprint("auth", __name__, url_prefix="/auth")


def _credentials() -> UserCreate:
    data = request.get_json(silent=True)
    return UserCreate.model_validate(data if isinstance(data, dict) else {})


@bp.post("/register")
def register():
    db = db_session()
    payload = _credentials()
    email = payload.email.lower()
    if db.scalar(select(User).where(User.email == email)):
        raise ApiError(409, "email already registered")
    user = User(email=email, password_hash=hash_password(payload.password))
    db.add(user)
    db.commit()
    db.refresh(user)
    return UserRead.model_validate(user).model_dump(mode="json"), 201


@bp.post("/login")
def login():
    db = db_session()
    payload = _credentials()
    user = db.scalar(select(User).where(User.email == payload.email.lower()))
    if user is None or not verify_password(payload.password, user.password_hash):
        raise ApiError(401, "invalid credentials")
    return Token(access_token=create_access_token(user.id)).model_dump()


@bp.get("/me")
def me():
    return UserRead.model_validate(current_user(db_session())).model_dump(mode="json")
