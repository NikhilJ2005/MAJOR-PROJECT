def _problem(status: int, detail, headers: dict | None = None) -> Response:
    response = Response(json.dumps(problem(status, detail), default=str), status=status, mimetype=PROBLEM_JSON)
    response.headers.update(headers or {})
    return response


@app.errorhandler(ApiError)
def api_error(exc: ApiError):
    return _problem(exc.status_code, exc.detail, error_headers(exc))


@app.errorhandler(ValidationError)
def validation_error(exc: ValidationError):
    return _problem(422, json.loads(exc.json(include_url=False)))


@app.errorhandler(HTTPException)
def http_error(exc: HTTPException):
    return _problem(exc.code or 500, exc.description)


@app.before_request
def start_request() -> None:
    """Give every request an id (the caller's X-Request-ID, or a new one) for the logs and the response."""
    g.started = time.perf_counter()
    g.request_id = logs.new_request_id(request.headers.get("X-Request-ID"))
    logs.request_id.set(g.request_id)


@app.after_request
def finish(response: Response) -> Response:
    origin = request.headers.get("Origin")
    if origin and origin in config.CORS_ORIGINS:
        response.headers["Access-Control-Allow-Origin"] = origin
        response.headers["Access-Control-Allow-Headers"] = "Authorization, Content-Type"
        response.headers["Access-Control-Allow-Methods"] = "GET, POST, PATCH, DELETE, OPTIONS"
    ms = (time.perf_counter() - g.get("started", time.perf_counter())) * 1000
    response.headers["X-Request-ID"] = g.get("request_id", "")
    response.headers.update(logs.SECURITY_HEADERS)
    if request.headers.get("X-Forwarded-Proto", request.scheme) == "https":
        response.headers["Strict-Transport-Security"] = logs.HSTS
    logs.record(request.method, request.path, response.status_code, ms / 1000)
    log.info("%s %s -> %s (%.0f ms)", request.method, request.path, response.status_code, ms)
    return response


@app.teardown_appcontext
def close_db(_exc) -> None:
    db = g.pop("db", None)
    if db is not None:
        db.close()


@app.get("/")
def frontend():
    """The generated web app (Flask serves app/static/ at /static/ by itself)."""
    return send_from_directory(app.static_folder, "index.html")


@app.get("/health")
def health():
    return {"status": "ok"}


@app.get("/metrics")
def metrics():
    """Requests by route and status, for Prometheus."""
    return Response(logs.metrics_text(), mimetype="text/plain")


@app.get("/ready")
def ready():
    if not database_ok():
        raise ApiError(503, "database unavailable")
    return {"status": "ready"}


@app.get("/openapi.json")
def openapi():
    return Response((HERE / "openapi.json").read_text(), mimetype="application/json")


@app.get("/docs")
def docs():
    return Response((HERE / "docs.html").read_text(), mimetype="text/html")
