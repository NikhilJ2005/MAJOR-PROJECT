[project]
name = "{{ spec.project_name | replace('_', '-') }}"
version = "0.1.0"
description = {{ spec.description | tojson }}
requires-python = ">=3.11"
dependencies = [
    "fastapi>=0.110",
    "uvicorn[standard]>=0.28",
    "sqlalchemy>=2.0",
    "pydantic>=2.6",
    "psycopg[binary]>=3.1",
{% if spec.auth %}
    "pyjwt>=2.8",
{% endif %}
]

[project.optional-dependencies]
dev = ["pytest>=8.0", "httpx>=0.27"]

[tool.pytest.ini_options]
testpaths = ["tests"]
