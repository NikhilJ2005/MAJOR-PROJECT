from fastapi import APIRouter, Depends, HTTPException, Query, Response, status
from sqlalchemy import select
from sqlalchemy.exc import IntegrityError
from sqlalchemy.orm import Session

from app.database import get_db
from app.models.{{ e.module }} import {{ e.name }}
from app.schemas.{{ e.module }} import {{ e.name }}Create, {{ e.name }}Read, {{ e.name }}Update
{% if spec.auth %}
from app.security import get_current_user
{% endif %}

router = APIRouter(prefix="/{{ e.table }}", tags=["{{ e.name }}"])
{% if spec.auth %}
protected = [Depends(get_current_user)]
{% else %}
protected = []
{% endif %}


def _get_or_404(db: Session, item_id: int) -> {{ e.name }}:
    obj = db.get({{ e.name }}, item_id)
    if obj is None:
        raise HTTPException(status_code=404, detail="{{ e.name }} not found")
    return obj


def _commit(db: Session) -> None:
    try:
        db.commit()
    except IntegrityError as exc:
        db.rollback()
        raise HTTPException(status_code=409, detail="constraint violation") from exc


@router.post("/", response_model={{ e.name }}Read, status_code=status.HTTP_201_CREATED, dependencies=protected)
def create_{{ e.module }}(payload: {{ e.name }}Create, db: Session = Depends(get_db)):
    obj = {{ e.name }}(**payload.model_dump())
    db.add(obj)
    _commit(db)
    db.refresh(obj)
    return obj


@router.get("/", response_model=list[{{ e.name }}Read])
def list_{{ e.table }}(
    skip: int = Query(0, ge=0),
    limit: int = Query(50, ge=1, le=100),
{% if search_field %}
    q: str | None = Query(None, description="Search in {{ search_field }}"),
{% endif %}
    db: Session = Depends(get_db),
):
    stmt = select({{ e.name }})
{% if search_field %}
    if q:
        stmt = stmt.where({{ e.name }}.{{ search_field }}.ilike(f"%{q}%"))
{% endif %}
    return db.scalars(stmt.order_by({{ e.name }}.id).offset(skip).limit(limit)).all()


@router.get("/{item_id}", response_model={{ e.name }}Read)
def get_{{ e.module }}(item_id: int, db: Session = Depends(get_db)):
    return _get_or_404(db, item_id)


@router.patch("/{item_id}", response_model={{ e.name }}Read, dependencies=protected)
def update_{{ e.module }}(item_id: int, payload: {{ e.name }}Update, db: Session = Depends(get_db)):
    obj = _get_or_404(db, item_id)
    for key, value in payload.model_dump(exclude_unset=True).items():
        setattr(obj, key, value)
    _commit(db)
    db.refresh(obj)
    return obj


@router.delete("/{item_id}", status_code=status.HTTP_204_NO_CONTENT, dependencies=protected)
def delete_{{ e.module }}(item_id: int, db: Session = Depends(get_db)):
    obj = _get_or_404(db, item_id)
    db.delete(obj)
    _commit(db)
    return Response(status_code=status.HTTP_204_NO_CONTENT)
